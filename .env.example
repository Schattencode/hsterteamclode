# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# Database Configuration
DATABASE_PATH=./data/hosting.db

# PowerDNS Configuration
PDNS_API_URL=http://localhost:8081/api/v1
PDNS_API_KEY=your_random_api_key_here

# DNS Nameservers (will be shown to users)
NS1_HOSTNAME=ns1.yourdomain.com
NS2_HOSTNAME=ns2.yourdomain.com

# Upload Configuration
MAX_UPLOAD_SIZE_MB=100
TEMP_UPLOAD_DIR=./uploads

# SSL Configuration
SSL_ADMIN_EMAIL=admin@yourdomain.com
SSL_STAGING=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/bot.log

# Server Configuration
PORT=3000
NODE_ENV=production
